# Local configuration template. Copy to `.env` and fill only what you need.
# Every value here is a placeholder; never put real credentials in this file.
# Synthetic mode is the default and needs no private source credentials.

# development | dogfood | staging | production
PF_ENVIRONMENT=development

# synthetic: fixtures only, no live sources or paid model calls.
# live: real sources and providers; requires the credentials below through the secret provider.
PF_DATA_MODE=synthetic

# Accept tokens from the signed local fixture issuer. Refused unless PF_ENVIRONMENT=development.
PF_AUTH_FIXTURE_ISSUER=false

# Where secrets come from: aws (Secrets Manager, then Parameter Store) or deployment
# (PF_<LOGICAL_NAME> variables injected by the deployment). Defaults to aws in staging and
# production, deployment elsewhere. The AWS provider looks names up under PF_SECRET_PREFIX
# (default property-focus/<environment>) in PF_AWS_REGION.
# PF_SECRET_PROVIDER=deployment
# PF_SECRET_PREFIX=property-focus/development
# PF_AWS_REGION=us-east-1

# Database connections, without passwords (defaults: the local Compose postgres service).
# The runtime role serves the application; the migration owner runs `property-focus migrate`.
# Passwords, where the server needs them, come from the secret provider as the logical
# names database_password and migration_database_password (PF_DATABASE_PASSWORD and
# PF_MIGRATION_DATABASE_PASSWORD with the deployment provider).
# PF_DATABASE_URL=postgresql+psycopg://pf_runtime@localhost:5432/property_focus
# PF_MIGRATION_DATABASE_URL=postgresql+psycopg://pf_migrator@localhost:5432/property_focus

# OIDC access-token validation. The values below are the local Keycloak realm; outside
# development the issuer is required and must be https. The verifier reads the issuer's
# discovery document and key set (JWKS) and calls no other identity-provider API.
PF_OIDC_ISSUER=http://localhost:8080/realms/property-focus
# Key-set URL override for a backchannel host. Unset on the host; inside Compose use
# http://keycloak:8080/realms/property-focus/protocol/openid-connect/certs
# PF_OIDC_JWKS_URL=
# Accepted audiences (comma-separated) and the claim that holds them.
PF_OIDC_AUDIENCE=property-focus-api
PF_OIDC_AUDIENCE_CLAIM=aud
# claim=value marking an access token (Cognito: token_use=access).
PF_OIDC_TOKEN_TYPE=typ=Bearer
# Allowed signing algorithms, a subset of RS256,ES256.
PF_OIDC_ALGORITHMS=RS256,ES256
PF_OIDC_CLOCK_SKEW_SECONDS=60

# The MCP server (port 8001): its public URL, which the protected-resource metadata and the
# 401 challenge name, and the Host and Origin values it serves (comma-separated). The values
# below are the development defaults for `make dev`; every other environment must set all three.
PF_MCP_PUBLIC_URL=http://localhost:8001/mcp
PF_MCP_ALLOWED_HOSTS=localhost:8001,127.0.0.1:8001
PF_MCP_ALLOWED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001

# OTLP/HTTP collector for traces and metrics (the local Compose `otel` service listens on
# 4318). Unset exports nothing; logs always go to standard error as JSON lines.
# PF_OTLP_ENDPOINT=http://localhost:4318

# Opt-in live integration tests, which arrive in a later phase with their own make target;
# 0 keeps them off.
PF_LIVE=0

# Live-mode credentials stay empty in synthetic mode. Real values come from the
# deployment's secret provider, not from this file.
# PF_MLS_MAILBOX_PASSWORD=
# PF_OPENAI_API_KEY=
# PF_ANTHROPIC_API_KEY=

# Local Keycloak (docker compose service `keycloak`, http://localhost:8080). The bootstrap
# admin manages the local server and is what the integration tests use to create
# synthetic users. Choose your own local values; deployed environments inject theirs.
PF_KEYCLOAK_ADMIN_USERNAME=local-admin
PF_KEYCLOAK_ADMIN_PASSWORD=replace-with-a-local-password
# Web app origin for the realm's web client redirect URIs and web origins.
# PF_WEB_ORIGIN=http://localhost:5173
# Most clients the realm holds, built-in and dynamically registered ones together.
# PF_KEYCLOAK_MAX_CLIENTS=100
