{
  "components": {
    "schemas": {
      "Health": {
        "description": "A health probe result.",
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Health",
        "type": "object"
      },
      "Problem": {
        "description": "An error response body (``application/problem+json``, RFC 9457).\n\n``code`` is a stable error code and ``failure_class`` its class, or null for request\nerrors and other non-failures. ``detail`` is redacted and safe to show to the user.\n``retry_after_seconds`` is present only when the caller should wait before retrying.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "correlation_id": {
            "title": "Correlation Id",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "failure_class": {
            "anyOf": [
              {
                "enum": [
                  "TRANSIENT",
                  "AUTH_REQUIRED",
                  "DATA_UNAVAILABLE",
                  "INVALID_INPUT",
                  "PERMANENT",
                  "BUG_UNKNOWN"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure Class"
          },
          "retry_after_seconds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retry After Seconds"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "failure_class",
          "detail",
          "correlation_id",
          "retryable"
        ],
        "title": "Problem",
        "type": "object"
      },
      "WorkflowRun": {
        "description": "A unit of background work: its state, its steps and what it produced.",
        "properties": {
          "analysis_tier": {
            "anyOf": [
              {
                "enum": [
                  "BASELINE",
                  "DEEP"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Analysis Tier"
          },
          "budget_tier": {
            "anyOf": [
              {
                "enum": [
                  "BASELINE",
                  "DEEP",
                  "EXPERIMENT"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Budget Tier"
          },
          "correlation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correlation Id"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "failure_class": {
            "anyOf": [
              {
                "enum": [
                  "TRANSIENT",
                  "AUTH_REQUIRED",
                  "DATA_UNAVAILABLE",
                  "INVALID_INPUT",
                  "PERMANENT",
                  "BUG_UNKNOWN"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure Class"
          },
          "failure_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure Code"
          },
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "result_refs": {
            "items": {
              "type": "string"
            },
            "title": "Result Refs",
            "type": "array"
          },
          "started_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "state": {
            "enum": [
              "QUEUED",
              "RUNNING",
              "COMPLETE",
              "PARTIAL",
              "WAITING_FOR_USER",
              "FAILED",
              "CANCELLED"
            ],
            "title": "State",
            "type": "string"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/WorkflowStep"
            },
            "title": "Steps",
            "type": "array"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "state",
          "analysis_tier",
          "budget_tier",
          "failure_class",
          "failure_code",
          "correlation_id",
          "result_refs",
          "created_at",
          "updated_at",
          "started_at",
          "finished_at",
          "steps"
        ],
        "title": "WorkflowRun",
        "type": "object"
      },
      "WorkflowStep": {
        "description": "One component of a workflow run and its latest failure, if any.",
        "properties": {
          "attempt_count": {
            "title": "Attempt Count",
            "type": "integer"
          },
          "failure_class": {
            "anyOf": [
              {
                "enum": [
                  "TRANSIENT",
                  "AUTH_REQUIRED",
                  "DATA_UNAVAILABLE",
                  "INVALID_INPUT",
                  "PERMANENT",
                  "BUG_UNKNOWN"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure Class"
          },
          "failure_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure Code"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "next_attempt_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Attempt At"
          },
          "result_refs": {
            "items": {
              "type": "string"
            },
            "title": "Result Refs",
            "type": "array"
          },
          "retryable": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retryable"
          },
          "safe_explanation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Safe Explanation"
          },
          "state": {
            "enum": [
              "QUEUED",
              "RUNNING",
              "COMPLETE",
              "PARTIAL",
              "WAITING_FOR_USER",
              "FAILED",
              "CANCELLED"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "name",
          "state",
          "attempt_count",
          "failure_class",
          "failure_code",
          "retryable",
          "safe_explanation",
          "next_attempt_at",
          "result_refs"
        ],
        "title": "WorkflowStep",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "An OIDC access token from the issuer.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Property Focus API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "description": "The process is serving requests.",
        "operationId": "getLiveness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "description": "The process can serve requests: its database answers.",
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/workflow-runs/{run_id}": {
      "get": {
        "description": "A workflow run of the caller's tenant, with its steps and results.\n\nReturns ``404`` for a run that does not exist and for one the caller may not see, with\nthe same body.",
        "operationId": "getWorkflowRun",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowRun"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Workflow Run",
        "tags": [
          "workflow-runs"
        ]
      }
    }
  }
}
